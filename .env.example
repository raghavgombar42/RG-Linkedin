# Copy this file to .env and fill in real values. Never commit .env.
# Add the same variables in Vercel -> Project -> Settings -> Environment Variables.

# --- Required (L3) ---
# From @BotFather
TELEGRAM_BOT_TOKEN=your_token_here
# From https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
# Who the bot listens to. Your channel id (-100...) and/or your own user id, comma-separated.
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# --- Optional ---
# Any random string. If set, pass it as secret_token when you call setWebhook.
TELEGRAM_WEBHOOK_SECRET=
# Gemini model used for scoring, keywords, transcription (and drafting if no Claude key).
GEMINI_MODEL=gemini-2.5-flash

# --- B1: Memory (Supabase -> Project Settings -> API) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- B1: Claude drafting (console.anthropic.com). If set, drafts use Claude instead of Gemini. ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# Force a provider for drafting: "gemini" or "claude". Leave blank for auto.
DRAFT_PROVIDER=

# Minimum score (0-10) a note needs before it gets drafted.
MIN_SCORE=6
